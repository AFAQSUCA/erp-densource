+
+class ArticleSerializer(serializers.ModelSerializer):
+    """Pièce du stock. ``sous_seuil`` suit la règle du centre d'alertes (seuil atteint, seuil 0 = non surveillé)."""
+
+    sous_seuil = serializers.SerializerMethodField()
+
+    class Meta:
+        model = Article
+        fields = ("id", "reference", "designation", "categorie", "quantite", "seuil_minimal", "pump", "sous_seuil")
+        read_only_fields = fields
+
+    def get_sous_seuil(self, article) -> bool:
+        return article.seuil_minimal > 0 and article.quantite <= article.seuil_minimal
+
